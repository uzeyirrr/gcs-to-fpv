# --- GCS (S3 uyumlu / HMAC interoperability anahtarlari) ---
S3_ENDPOINT=https://storage.googleapis.com
S3_BUCKET=bucket-adiniz
S3_REGION=europe-west3
S3_ACCESS_KEY=GOOG...
S3_SECRET=...
S3_FORCE_PATH_STYLE=true
# FTP kokunu bucket icindeki bir klasore sabitlemek icin (opsiyonel)
# S3_PREFIX=alt/klasor

# --- FTP sunucusu ---
FTP_HOST=0.0.0.0
FTP_PORT=21
# ONEMLI: pasif mod icin istemciye bildirilen adres.
# Dokploy/VPS'te sunucunun DIS IP adresini yazin.
FTP_PASV_URL=1.2.3.4
FTP_PASV_MIN=50000
FTP_PASV_MAX=50099
FTP_USER=gcs
FTP_PASS=guclu-bir-parola
FTP_ANONYMOUS=false
